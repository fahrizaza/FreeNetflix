# Konfigurasi server untuk LiteSpeed / Apache (hosting cinemahub.my.id).
# Netlify tidak membaca berkas ini; netlify.toml yang lama abaikan saja.

# ---- Tipe MIME ----
# LiteSpeed di sini melayani .mjs dan .js sebagai application/octet-stream,
# dan browser MENOLAK menjalankan modul ES yang bukan tipe JavaScript. Akibatnya
# satu import saja menggagalkan seluruh script.js -- halaman jadi hitam total.
# Baris di bawah memaksa tipe yang benar. AddType menimpa apa pun tebakan server.
AddType application/javascript .js
AddType application/javascript .mjs
AddType application/json .json
AddType image/webp .webp

# ---- Kompresi ----
# WebP, JPEG, PNG, dan MP4 sengaja TIDAK ada di daftar ini: isinya sudah
# terkompresi, dan memampatkannya lagi hanya membakar CPU server untuk hasil
# yang kadang justru sedikit lebih besar.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Cache ----
# TANPA <FilesMatch>. Ini bukan gaya penulisan, ini keharusan.
#
# Versi sebelumnya membungkus aturan ini dalam <FilesMatch "\.(js|mjs|css)$">,
# dan LiteSpeed di hosting ini MENGABAIKANNYA tanpa suara -- diperiksa langsung
# ke server: script.js balik dengan max-age=604800 (7 hari) dari setelan bawaan
# server, bukan 3600 yang tertulis di sini. AddType dan RewriteRule di berkas
# yang sama jalan normal, jadi masalahnya khusus Header di dalam FilesMatch.
#
# Tujuh hari itu berbahaya, bukan cuma boros: index.html tidak ikut tercache,
# jadi pengunjung lama bisa memasangkan HTML baru dengan script.js seminggu lalu
# -- persis jenis kerusakan yang bikin layar hitam.
#
# Satu jam untuk semuanya, lalu ditimpa per folder oleh .htaccess di dalamnya:
#   data/.htaccess       30 menit  (katalog disegarkan harian)
#   assets/img/.htaccess setahun   (nama berkas ikut berubah kalau isinya beda)
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=3600"
</IfModule>

# ---- SPA fallback ----
# index.html satu-satunya halaman; JavaScript yang menggambar sisanya. Tanpa ini,
# membuka /apa-saja langsung (atau menyegarkan halaman dalam) menghasilkan 404.
# Berkas yang benar-benar ada tetap dilayani apa adanya.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
